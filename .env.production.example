APP_NAME="SolarFlow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Use the one public HTTPS origin that users will open. All other hosts redirect here.
APP_URL=https://www.solar.example.com
APP_TIMEZONE=Asia/Kolkata
FORCE_HTTPS=true
TRUSTED_PROXIES=127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=solar_energy
DB_USERNAME=solarflow
DB_PASSWORD=

# Use the same URL while syncing the Android/iOS wrapper.
SOLARFLOW_MOBILE_URL=https://solar.example.com
