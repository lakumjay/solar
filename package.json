{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "solarflow",
    "version": "1.0.0",
    "description": "Company-wise solar generation and meter reading management",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "desktop:start": "npm run build && electron .",
        "desktop:pack": "npm run build && electron-builder --dir",
        "desktop:build": "npm run build && electron-builder"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^5.2.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "electron": "^44.4.2",
        "electron-builder": "^26.15.3",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "wait-on": "^9.1.0"
    },
    "dependencies": {
        "lucide-react": "^1.47.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4"
    },
    "build": {
        "appId": "com.solarflow.desktop",
        "productName": "SolarFlow",
        "asar": true,
        "files": ["electron/**/*", "package.json"],
        "extraResources": [
            {"from": "app", "to": "laravel/app"},
            {"from": "bootstrap", "to": "laravel/bootstrap"},
            {"from": "config", "to": "laravel/config"},
            {"from": "database", "to": "laravel/database"},
            {"from": "public", "to": "laravel/public"},
            {"from": "resources/views", "to": "laravel/resources/views"},
            {"from": "routes", "to": "laravel/routes"},
            {"from": "vendor", "to": "laravel/vendor"},
            {"from": "artisan", "to": "laravel/artisan"},
            {"from": "composer.json", "to": "laravel/composer.json"},
            {"from": "composer.lock", "to": "laravel/composer.lock"}
        ],
        "mac": {"target": ["dmg", "zip"], "category": "public.app-category.business"},
        "win": {"target": ["nsis"]},
        "linux": {"target": ["AppImage", "deb"], "category": "Office"}
    }
}
